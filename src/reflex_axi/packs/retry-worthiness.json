{
  "id": "retry-worthiness",
  "version": "1",
  "state": {
    "version": "1",
    "schema": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "maxLength": 16000
        },
        "context": {
          "type": "string",
          "maxLength": 32000
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 100
        },
        "attempt": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "task",
        "context"
      ],
      "additionalProperties": false
    }
  },
  "judgment": {
    "version": "1",
    "primitive": "binary",
    "labels": [
      "false",
      "true"
    ],
    "question": "Given the failure and prior attempts in context, would another attempt with the same capability plausibly resolve a transient or bounded gap? Judge semantic retry value; retry counts and budgets are deterministic caller checks."
  },
  "policy": {
    "version": "1",
    "kind": "recommend",
    "min_confidence": 0.8,
    "actions": {
      "false": "consider-escalation",
      "true": "retry-proposal"
    },
    "uncertain": "escalate"
  },
  "metadata": {
    "purpose": "gating",
    "status": "starter-unvalidated",
    "note": "Validate and calibrate on your workload before production; mock output is only a fixture."
  }
}
